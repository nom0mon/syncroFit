erDiagram
    users ||--o| profiles : "has one"
    users ||--o{ workouts : "owns"
    users ||--o{ workout_history : "logs"
    users ||--o{ progress_logs : "records"
    users ||--o{ posts : "authors"
    users ||--o{ comments : "writes"
    users ||--o{ post_likes : "gives"

    profiles ||--o{ profile_availability : "available on"

    workouts ||--o{ workout_exercises : "contains"
    exercises ||--o{ workout_exercises : "prescribed in"

    workout_history ||--o{ workout_history_exercises : "contains"
    exercises |o--o{ workout_history_exercises : "snapshot of"

    posts ||--o{ comments : "has"
    posts ||--o{ post_likes : "receives"
    posts ||--o{ post_media : "has"

    users {
        int id PK
        varchar email UK
        varchar username UK
        varchar password
        text first_name
        text last_name
        varchar avatar_disk
        varchar avatar_path
        varchar avatar_mime_type
        datetime created_at
        datetime updated_at
    }

    profiles {
        int id PK
        int user_id FK
        int age
        numeric height_cm
        numeric weight_kg
        varchar gender
        varchar goal
        varchar fitness_level
        varchar workout_preference
        datetime created_at
        datetime updated_at
    }

    profile_availability {
        int id PK
        int profile_id FK
        varchar day_of_week
        datetime created_at
        datetime updated_at
    }

    exercises {
        int id PK
        varchar name
        text description
        text instructions
        varchar muscle_group
        varchar equipment
        varchar difficulty
        int default_sets
        int default_reps
        int default_duration_seconds
        varchar video_path
        varchar movement_pattern
        text primary_muscles
        text secondary_muscles
        varchar exercise_type
        text goals
        text environments
        varchar verification_status
        varchar source_reference
        datetime created_at
        datetime updated_at
    }

    workouts {
        int id PK
        int user_id FK
        varchar name
        varchar day_of_week
        int estimated_duration_minutes
        tinyint is_generated
        varchar plan_id
        tinyint is_accepted
        datetime accepted_at
        datetime created_at
        datetime updated_at
    }

    workout_exercises {
        int id PK
        int workout_id FK
        int exercise_id FK
        int sets
        int reps
        int duration_seconds
        int rest_seconds
        int position
        datetime created_at
        datetime updated_at
    }

    workout_history {
        int id PK
        int user_id FK
        varchar workout_name
        datetime completed_at
        int total_duration_seconds
        varchar client_mutation_id
        datetime created_at
        datetime updated_at
    }

    workout_history_exercises {
        int id PK
        int workout_history_id FK
        int exercise_id FK "nullable"
        varchar exercise_name
        int sets_completed
        int reps_or_duration
        tinyint is_duration
        int position
        datetime created_at
        datetime updated_at
    }

    progress_logs {
        int id PK
        int user_id FK
        varchar title
        text description
        numeric weight_kg
        varchar original_image_path
        varchar display_image_path
        datetime created_at
        datetime updated_at
    }

    posts {
        int id PK
        int user_id FK
        text content
        datetime created_at
        datetime updated_at
        datetime deleted_at
    }

    comments {
        int id PK
        int post_id FK
        int user_id FK
        text content
        datetime created_at
        datetime updated_at
        datetime deleted_at
    }

    post_likes {
        int id PK
        int post_id FK
        int user_id FK
        datetime created_at
        datetime updated_at
    }

    post_media {
        int id PK
        int post_id FK
        varchar disk
        varchar path
        varchar mime_type
        int size_bytes
        int width
        int height
        int position
        datetime created_at
        datetime updated_at
    }
