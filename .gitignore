# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Local editor and legacy assistant workspace state
/.vscode/
/.kiro/

# Local command output and distributable installers
/*_out.txt
/*_err.txt
/*_output.txt
/analyze_output.txt
/analyze_result.txt
/output*.txt
/test_ex.txt
/flutter_*.log
/*.apk

# Android release signing material is injected by protected CI/environment only
/android/key.properties
/android/app/key.properties
/android/app/upload-keystore.jks
/android/app/*.keystore
/android/app/*.jks
